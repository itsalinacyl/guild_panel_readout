<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Guild concentration panel — site-resolved readout</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#ffffff;
    --ink:#14201d;
    --muted:#5c6b66;
    --faint:#8b9994;
    --rule:#dce2e0;
    --rule-strong:#b6c1bd;
    --warm:192,95,51;
    --cool:36,117,106;
    --sans:"IBM Plex Sans","Helvetica Neue",Arial,sans-serif;
    --serif:"Source Serif 4",Georgia,"Times New Roman",serif;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0;background:var(--paper);color:var(--ink);
    font-family:var(--sans);font-size:15px;line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .sheet{max-width:1080px;margin:0 auto;padding:48px 32px 80px}

  /* ---------- masthead ---------- */
  .claim{
    font-family:var(--serif);font-weight:600;
    font-size:clamp(26px,3.4vw,40px);line-height:1.18;
    letter-spacing:-0.012em;margin:0 0 18px;max-width:26ch;
  }
  .stand{
    font-family:var(--serif);font-size:17px;line-height:1.62;
    color:var(--muted);max-width:66ch;margin:0 0 6px;
  }
  .stand b{color:var(--ink);font-weight:600}
  .byline{
    margin-top:26px;padding-top:14px;border-top:1px solid var(--rule);
    font-size:12.5px;color:var(--faint);display:flex;flex-wrap:wrap;gap:6px 28px;
  }

  /* ---------- section framing ---------- */
  .band{margin-top:56px}
  .band-head{
    display:flex;align-items:baseline;justify-content:space-between;
    gap:20px;flex-wrap:wrap;
    border-bottom:1.5px solid var(--ink);padding-bottom:9px;margin-bottom:22px;
  }
  .band-head h2{
    font-family:var(--serif);font-weight:600;font-size:20px;
    letter-spacing:-0.01em;margin:0;
  }
  .band-head p{margin:0;font-size:12.5px;color:var(--muted);max-width:46ch}

  /* ---------- matrix ---------- */
  .matrix-wrap{overflow-x:auto;padding-bottom:4px}
  table.matrix{border-collapse:collapse;width:100%;min-width:660px}
  table.matrix th, table.matrix td{padding:0}
  .col-site{
    font-size:13.5px;font-weight:600;text-align:center;
    padding:0 0 4px;letter-spacing:0.005em;
  }
  .col-n{
    font-size:11px;font-weight:400;color:var(--faint);
    text-align:center;padding-bottom:9px;
  }
  .grp{
    font-family:var(--serif);font-size:12.5px;font-style:italic;color:var(--muted);
    text-align:left;vertical-align:middle;white-space:nowrap;
    padding:0 14px 0 0;border-right:1px solid var(--rule-strong);
    width:1%;
  }
  .metric{
    font-size:13px;font-weight:400;text-align:left;white-space:nowrap;
    padding:0 16px 0 14px;color:var(--ink);width:1%;
  }
  .metric small{display:block;font-size:10.5px;color:var(--faint);letter-spacing:0.01em}
  tr.grp-end > td, tr.grp-end > th{border-bottom:1px solid var(--rule)}

  .cellbox{padding:3px}
  button.cell{
    display:block;width:100%;min-width:104px;height:58px;
    border:1px solid transparent;background:transparent;
    font-family:var(--sans);font-size:15px;font-weight:600;
    letter-spacing:-0.01em;color:var(--ink);cursor:pointer;
    position:relative;transition:none;
  }
  button.cell .glyph{font-size:13px;font-weight:500;opacity:.62}
  button.cell.keyed{border-color:rgba(20,32,29,.55)}
  button.cell.contra::after{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:repeating-linear-gradient(
      -45deg, rgba(20,32,29,.30) 0 1px, transparent 1px 7px);
  }
  button.cell:focus-visible{outline:2.5px solid var(--ink);outline-offset:2px}
  button.cell[aria-pressed="true"]{
    box-shadow:inset 0 0 0 2.5px var(--ink);
  }
  .qmark{
    position:absolute;top:4px;right:6px;font-size:9.5px;font-weight:600;
    letter-spacing:.02em;opacity:.8;
  }

  /* ---------- legend ---------- */
  .legend{
    display:flex;flex-wrap:wrap;gap:10px 30px;margin-top:16px;
    font-size:12px;color:var(--muted);align-items:center;
  }
  .legend span{display:flex;align-items:center;gap:8px}
  .swatch{width:34px;height:13px;display:inline-block;border:1px solid var(--rule-strong)}
  .swatch.hatch{background:repeating-linear-gradient(-45deg,rgba(20,32,29,.30) 0 1px,transparent 1px 7px);}
  .scalebar{
    width:120px;height:13px;display:inline-block;border:1px solid var(--rule-strong);
    background:linear-gradient(90deg,
      rgba(var(--cool),.80) 0%, rgba(var(--cool),.18) 46%,
      rgba(var(--warm),.18) 54%, rgba(var(--warm),.80) 100%);
  }

  /* ---------- readout drawer ---------- */
  .drawer{
    margin-top:24px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);
    padding:18px 0;min-height:118px;
  }
  .drawer-idle{font-family:var(--serif);font-size:16px;line-height:1.6;color:var(--muted);max-width:70ch;margin:0}
  .drawer-idle b{color:var(--ink);font-weight:600}
  .dh{font-size:13px;font-weight:600;letter-spacing:.005em;margin:0 0 3px}
  .dh em{font-style:normal;color:var(--faint);font-weight:400}
  .dstat{
    display:flex;flex-wrap:wrap;gap:4px 26px;margin:10px 0 0;
    font-size:12.5px;color:var(--muted);
  }
  .dstat b{color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums}
  .dverdict{
    font-family:var(--serif);font-size:15.5px;line-height:1.55;
    margin:11px 0 0;max-width:72ch;color:var(--ink);
  }

  /* ---------- per-site strip ---------- */
  .sites{
    display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:34px;
    border-top:1.5px solid var(--ink);
  }
  .site{padding:14px 18px 4px 0;border-right:1px solid var(--rule)}
  .site:last-child{border-right:0;padding-right:0}
  .site h3{font-size:13.5px;font-weight:600;margin:0 0 5px}
  .site p{font-family:var(--serif);font-size:14px;line-height:1.5;color:var(--muted);margin:0}
  .site p b{color:var(--ink);font-weight:600}

  .aside{
    font-family:var(--serif);font-size:15.5px;line-height:1.62;
    color:var(--ink);max-width:74ch;margin:30px 0 0;
    padding-left:16px;border-left:2px solid var(--ink);
  }
  .aside span{color:var(--muted)}

  /* ---------- spec ---------- */
  .spec{display:grid;grid-template-columns:repeat(3,1fr);gap:0 34px}
  .spec section{border-top:1px solid var(--rule-strong);padding-top:12px}
  .spec h3{font-size:12.5px;font-weight:600;margin:0 0 9px}
  .spec ol,.spec ul{margin:0;padding-left:17px}
  .spec li{font-size:13px;line-height:1.5;color:var(--muted);margin-bottom:7px}
  .spec li b{color:var(--ink);font-weight:500}
  .spec code{
    font-family:var(--sans);font-size:12px;color:var(--ink);
    background:rgba(36,117,106,.09);padding:0 3px;
  }

  /* ---------- conservation ---------- */
  .cons-wrap{overflow-x:auto}
  table.cons{border-collapse:collapse;width:100%;min-width:720px}
  table.cons th{
    font-size:11px;font-weight:500;color:var(--faint);text-align:left;
    padding:0 18px 7px 0;border-bottom:1px solid var(--rule-strong);white-space:nowrap;
  }
  table.cons td{
    padding:13px 18px 13px 0;border-bottom:1px solid var(--rule);
    vertical-align:middle;font-size:13px;color:var(--muted);
  }
  table.cons tr.split td{border-bottom:1.5px solid var(--ink)}
  td.site-c{color:var(--ink);font-weight:600;font-size:13.5px;white-space:nowrap;width:1%}
  td.core{font-variant-numeric:tabular-nums;white-space:nowrap;width:1%}
  .bar-wrap{display:flex;align-items:center;gap:11px;min-width:210px}
  .bar{height:11px;background:rgba(var(--cool),.75);display:block}
  .bar-val{font-size:13.5px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;min-width:44px}
  td.plain{font-family:var(--serif);font-size:13.5px;line-height:1.45;color:var(--muted)}
  .gloss{
    font-size:12.5px;line-height:1.6;color:var(--muted);max-width:80ch;
    margin:18px 0 0;padding:12px 0 0;border-top:1px solid var(--rule);
  }
  .gloss b{color:var(--ink);font-weight:600}
  .fit-sing{color:var(--ink);font-weight:500}
  .coef{font-variant-numeric:tabular-nums;white-space:nowrap;font-size:12.5px}
  .coef b{color:var(--ink);font-weight:600}
  .coef em{font-style:normal;color:var(--faint)}

  table.denom{border-collapse:collapse;margin-top:30px;font-size:12.5px;width:100%}
  table.denom caption{
    text-align:left;font-size:12.5px;font-weight:600;padding-bottom:8px;color:var(--ink);
  }
  table.denom th{
    text-align:left;font-weight:500;color:var(--faint);font-size:11px;
    padding:0 16px 6px 0;border-bottom:1px solid var(--rule-strong);white-space:nowrap;
  }
  table.denom td{
    padding:6px 16px 6px 0;border-bottom:1px solid var(--rule);
    color:var(--muted);font-variant-numeric:tabular-nums;
  }
  table.denom td:first-child{color:var(--ink);font-weight:500}

  .foot{
    margin-top:40px;padding-top:14px;border-top:1px solid var(--rule);
    font-size:12px;color:var(--faint);max-width:78ch;line-height:1.55;
  }

  @media (max-width:820px){
    .sheet{padding:34px 20px 60px}
    .spec{grid-template-columns:1fr;gap:26px}
    .sites{grid-template-columns:1fr 1fr}
    .site{border-right:0;border-bottom:1px solid var(--rule);padding-right:18px}
  }
  @media print{
    .sheet{max-width:none;padding:0}
    button.cell{cursor:default}
    .drawer{min-height:0}
  }
</style>
</head>
<body>
<main class="sheet">

  <h1 class="claim">Insulin resistance rearranges guild internal structure</h1>

  <p class="stand">
    Guilds were derived inside each subject’s own six-year timeseries, one network per person, so
    within-person co-variation is never inferred from population-level co-variation.
    <b>Guild count, guild size and guild-level individuality were comparable between insulin-resistant
    and insulin-sensitive subjects at all four sites.</b> The difference sat inside guilds, in share
    structure, on a different axis at every site.
  </p>
  <p class="stand">
    Eight established ecology measures read that structure out, computed on the guild sub-community
    and not the whole sample. The direction predicted by consumer–resource models of dysbiosis was
    fixed in advance.
  </p>

  <div class="byline">
    <span>iPOP cohort · 86 adults · stool, skin, oral, nasal · ~6 years</span>
    <span>Per-subject SparCC networks · Louvain partition</span>
    <span>Effect size: Cliff’s δ, bootstrap CI, Benjamini–Hochberg within site</span>
  </div>

  <!-- ================= MATRIX ================= -->
  <div class="band">
    <div class="band-head">
      <h2>Which axis of guild architecture carries the metabolic signal</h2>
      <p>Select any cell for its effect size, interval and predicted direction.</p>
    </div>

    <div class="matrix-wrap">
      <table class="matrix" id="matrix">
        <thead>
          <tr id="hrow1"><th></th><th></th></tr>
          <tr id="hrow2"><th></th><th></th></tr>
        </thead>
        <tbody id="mbody"></tbody>
      </table>
    </div>

    <div class="legend">
      <span><i class="scalebar"></i> δ &nbsp;lower in IR &nbsp;←&nbsp; 0 &nbsp;→&nbsp; higher in IR</span>
      <span><i class="swatch" style="border-color:rgba(20,32,29,.55)"></i> reached the |δ| ≥ 0.33 reporting threshold</span>
      <span><i class="swatch hatch"></i> runs opposite to the predicted dysbiosis direction</span>
      <span>▲ ▼ direction only, below threshold</span>
    </div>

    <div class="drawer" id="drawer" aria-live="polite">
      <p class="drawer-idle">
        Four cells cleared the threshold at skin, two at nasal, one at oral and none at stool.
        The panel was applied identically at all four sites.
      </p>
    </div>

    <div class="sites" id="sites"></div>

    <p class="aside">
      Turnover tracked architecture more closely than phenotype. Regressing consecutive-timepoint drift on a guild’s own
      dominance and size returns negative coefficients at all four sites; at stool
      <span>(−0.416, t = −4.23 for dominance; −0.0086, t = −4.65 for size)</span> and oral
      <span>(−0.394, t = −3.58; −0.0104, t = −4.07)</span> each holds with the other in the model.
      This is consistent with larger, less dominated guilds drifting less, including at the sites where
      metabolic state produced no architectural difference — a relationship that requires further
      testing before it can be read as ecological.
    </p>
  </div>

  <!-- ================= CONSERVATION ================= -->
  <div class="band">
    <div class="band-head">
      <h2>Do independently built guilds put the same genera together?</h2>
      <p>Each person’s network was built from their samples alone. If the same genus keeps the same neighbours in different people, that pairing is not an accident of one network.</p>
    </div>

    <p class="stand" style="margin-bottom:22px">
      For every signature genus tested, partners co-occurred more often than a permutation null that
      shuffles guild membership while holding each subject’s guild sizes and genus pool fixed
      (p &lt; 0.01 at all four sites). The column below reads as <b>how many times more often than
      chance</b> the same genera land in the same guild.
    </p>

    <div class="cons-wrap">
      <table class="cons">
        <thead>
          <tr>
            <th scope="col">Site</th>
            <th scope="col">Core genera<br><span style="font-weight:400">reported for this cohort</span></th>
            <th scope="col">Same genera land in the same guild…</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="site-c">Skin</td>
            <td class="core">3</td>
            <td><span class="bar-wrap"><i class="bar" style="width:98%"></i><span class="bar-val">6.9×</span></span></td>
            <td class="plain">more often than chance</td>
          </tr>
          <tr class="split">
            <td class="site-c">Nasal</td>
            <td class="core">3</td>
            <td><span class="bar-wrap"><i class="bar" style="width:76%"></i><span class="bar-val">5.3×</span></span></td>
            <td class="plain">more often than chance</td>
          </tr>
          <tr>
            <td class="site-c">Oral</td>
            <td class="core">&gt;25</td>
            <td><span class="bar-wrap"><i class="bar" style="width:34%"></i><span class="bar-val">2.4×</span></span></td>
            <td class="plain">more often than chance</td>
          </tr>
          <tr>
            <td class="site-c">Stool</td>
            <td class="core">&gt;25</td>
            <td><span class="bar-wrap"><i class="bar" style="width:30%"></i><span class="bar-val">2.1×</span></span></td>
            <td class="plain">more often than chance</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="aside">
      The fewer core genera a site has, the more strongly its partnerships are conserved. Skin and
      nasal carry three core genera each and reach 6.9× and 5.3×; oral and stool carry more than 25
      each and reach 2.4× and 2.1×.
    </p>
  </div>

  <!-- ================= DRIFT ================= -->
  <div class="band">
    <div class="band-head">
      <h2>What predicts how much a guild changes between visits</h2>
      <p>Turnover is the Bray–Curtis dissimilarity between one visit and the next, computed on the guild’s own members. Higher means more change.</p>
    </div>

    <p class="stand" style="margin-bottom:20px">
      Two properties of a guild were tested as predictors: <b>how many genera it contains</b>, and
      <b>how concentrated it is in its single largest member</b> (Berger–Parker dominance). These are
      the same two measures that appear in the eight-metric panel above — there compared between IR and
      IS, here used as predictors of turnover. Both carried negative coefficients at all four sites,
      consistent with guilds holding more genera, and guilds less concentrated in one member, changing
      less between visits.
    </p>

    <div class="cons-wrap">
      <table class="cons">
        <thead>
          <tr>
            <th scope="col">Site</th>
            <th scope="col">Genera per guild<br><span style="font-weight:400">effect on turnover</span></th>
            <th scope="col">Berger–Parker dominance<br><span style="font-weight:400">effect on turnover</span></th>
            <th scope="col">Per-person term in the model</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="site-c">Stool</td>
            <td class="coef"><b>−0.0086</b> <em>t = −4.65</em></td>
            <td class="coef"><b>−0.416</b> <em>t = −4.23</em></td>
            <td class="plain">Estimated; each person’s baseline drift absorbed</td>
          </tr>
          <tr class="split">
            <td class="site-c">Oral</td>
            <td class="coef"><b>−0.0104</b> <em>t = −4.07</em></td>
            <td class="coef"><b>−0.394</b> <em>t = −3.58</em></td>
            <td class="plain">Estimated; each person’s baseline drift absorbed</td>
          </tr>
          <tr>
            <td class="site-c">Skin</td>
            <td class="coef"><em>negative</em></td>
            <td class="coef"><em>negative</em></td>
            <td class="plain">Not estimable — subjects too alike in drift; fitted without it</td>
          </tr>
          <tr>
            <td class="site-c">Nasal</td>
            <td class="coef"><em>negative</em></td>
            <td class="coef"><em>negative</em></td>
            <td class="plain">Not estimable — subjects too alike in drift; fitted without it</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="gloss">
      <b>Reading the numbers.</b> A negative coefficient means turnover falls as that property rises.
      <i>t</i> is the coefficient divided by its standard error; values beyond roughly ±2 indicate the
      coefficient is distinguishable from zero, and all four here exceed ±3.5. Both terms held with the
      other in the model, so genus count and concentration contribute separately. Skin and nasal are
      shown by direction only because the per-person term could not be estimated there.
    </p>

    <p class="gloss">
      <b>Limitation.</b> The unit of observation is the individual guild, and the association is
      correlational. Bray–Curtis computed on a small member sub-community is also mechanically more
      volatile than on a large one, since a single genus moves a larger share of the total, so part of
      the size coefficient may be arithmetic. Separating the two requires recomputing drift on a fixed
      number of members drawn per guild. This is a direction for further work, not a settled result.
    </p>

    <p class="aside">
      Metabolic state separated IR from IS turnover at nasal only, whereas the architectural association
      appeared at all four sites, including those where metabolic state produced no difference.
    </p>
  </div>

  <!-- ================= INSTRUMENT ================= -->
  <div class="band">
    <div class="band-head">
      <h2>Cohort and reporting rules</h2>
      <p>Thresholds held constant across subjects and sites.</p>
    </div>

    <table class="denom">
      <caption>Subjects retained per site after the ten-timepoint criterion</caption>
      <thead><tr><th>Site</th><th>In object</th><th>Retained</th><th>IS</th><th>IR</th><th>Unclassified</th><th>Guilds derived</th></tr></thead>
      <tbody>
        <tr><td>Stool</td><td>78</td><td>34</td><td>14</td><td>12</td><td>8</td><td>106</td></tr>
        <tr><td>Skin</td><td>86</td><td>39</td><td>18</td><td>12</td><td>9</td><td>107</td></tr>
        <tr><td>Oral</td><td>86</td><td>37</td><td>16</td><td>12</td><td>9</td><td>119</td></tr>
        <tr><td>Nasal</td><td>85</td><td>34</td><td>14</td><td>11</td><td>9</td><td>83</td></tr>
      </tbody>
    </table>

    <p class="foot">
      Thresholds were held constant across subjects and sites. Reporting rule set before analysis:
      metrics reaching |δ| ≥ 0.33 are reported with effect size and interval, metrics below it by direction only.
      Berger–Parker dominance, Gini inequality and Shannon evenness are three summaries of one share vector
      and are not independent; maximum enrichment is the only metric not normalised for guild size.
      Values not printed here fell below the reporting threshold and are shown by direction, as in the source analysis.
    </p>
  </div>
</main>

<script>
const SITES = [
  {k:"skin",  label:"Skin",  n:"18 IS / 12 IR", region:"V4"},
  {k:"nasal", label:"Nasal", n:"14 IS / 11 IR", region:"V1–V3"},
  {k:"oral",  label:"Oral",  n:"16 IS / 12 IR", region:"V4"},
  {k:"stool", label:"Stool", n:"14 IS / 12 IR", region:"V1–V3"}
];

// pred: sign expected in IR under consumer-resource models of dysbiosis
const METRICS = [
  {k:"genera", grp:"Size",      name:"Genera per guild",      sub:"distinct lineages",            pred:-1},
  {k:"asvs",   grp:"Size",      name:"ASVs per guild",        sub:"strain diversity carried",     pred:-1, last:true},
  {k:"bpd",    grp:"Dominance", name:"Berger–Parker dominance", sub:"largest member’s ASV share", pred:+1},
  {k:"bpa",    grp:"Dominance", name:"Berger–Parker (abundance)", sub:"largest member’s read share", pred:+1},
  {k:"maxenr", grp:"Dominance", name:"Maximum enrichment",    sub:"dominance × guild size",       pred:+1, last:true},
  {k:"gini",   grp:"Evenness",  name:"Gini inequality",       sub:"share inequality",             pred:+1},
  {k:"shan",   grp:"Evenness",  name:"Shannon evenness",      sub:"on strain share",              pred:-1},
  {k:"evab",   grp:"Evenness",  name:"Evenness (abundance)",  sub:"on read share",                pred:-1, last:true}
];

// keyed = reached |δ| >= 0.33 (value, CI, q printed). dir-only = below threshold.
const D = {
  skin: {
    genera:{d:+0.519, ci:"+0.139 to +0.829", q:"0.048", med:"7.0 IS → 9.0 IR", keyed:true},
    asvs:  {d:+0.523, ci:"+0.157 to +0.824", q:"0.048", med:"13.5 IS → 22.5 IR", keyed:true},
    bpd:   {d:-0.523, ci:"−0.824 to −0.130", q:"0.048", med:"0.280 IS → 0.252 IR", keyed:true},
    bpa:   {d:-0.213},
    maxenr:{d:+0.472, ci:"+0.083 to +0.796", q:"0.065", keyed:true},
    gini:  {d:+0.310},
    shan:  {d:-0.213},
    evab:  {d:-0.296}
  },
  nasal: {
    genera:{dir:-1}, asvs:{dir:-1},
    bpd:   {d:+0.364, ci:"−0.124 to +0.753", q:"0.528", med:"0.407 IS → 0.482 IR", keyed:true},
    bpa:   {dir:-1},
    maxenr:{d:+0.175},
    gini:  {d:+0.234},
    shan:  {d:-0.455, ci:"−0.844 to +0.026", q:"0.471", med:"0.884 IS → 0.833 IR", keyed:true},
    evab:  {dir:+1}
  },
  oral: {
    genera:{d:+0.344, ci:"−0.057 to +0.734", q:"0.954", med:"11.75 IS → 14.25 IR", keyed:true},
    asvs:  {dir:+1}, bpd:{dir:-1}, bpa:{dir:-1}, maxenr:{dir:+1},
    gini:  {dir:+1}, shan:{dir:-1}, evab:{dir:+1}
  },
  stool: {
    genera:{dir:-1},
    asvs:  {d:-0.220},
    bpd:   {dir:+1}, bpa:{dir:-1}, maxenr:{dir:+1},
    gini:  {dir:-1}, shan:{dir:+1},
    evab:  {d:+0.214}
  }
};

const VERDICT = {
  skin:{head:"Lineage count and strain-level dominance",
        text:"Four metrics cleared the threshold, three survived correction. IR guilds carry <b>more</b> genera and <b>more</b> ASVs at <b>lower</b> dominance — three of the four run opposite to the predicted dysbiosis direction. Both abundance-based metrics stayed negligible, so the signal sits in strain diversity, not reads."},
  nasal:{head:"Share structure",
        text:"Two metrics cleared the threshold, both in the predicted direction, neither surviving correction. Evenness falls and dominance rises in IR; guild size is untouched."},
  oral:{head:"Genera per guild alone",
        text:"One metric cleared the threshold — more genera per guild in IR, opposite to prediction. Every remaining metric fell below |δ| = 0.20."},
  stool:{head:"No architectural signal",
        text:"No metric reached |δ| = 0.33 and all eight intervals spanned zero."}
};

const fill = (d, keyed) => {
  const a = keyed ? Math.min(0.82, 0.20 + Math.abs(d)*1.15) : 0.13 + Math.abs(d||0)*0.28;
  const rgb = d >= 0 ? "var(--warm)" : "var(--cool)";
  return `rgba(${rgb},${a.toFixed(3)})`;
};
const fmt = d => (d>0?"+":"−") + Math.abs(d).toFixed(3);

// ---- header
const h1 = document.getElementById("hrow1"), h2 = document.getElementById("hrow2");
SITES.forEach(s=>{
  const a=document.createElement("th"); a.className="col-site"; a.scope="col"; a.textContent=s.label; h1.appendChild(a);
  const b=document.createElement("th"); b.className="col-n"; b.textContent=s.n+" · "+s.region; h2.appendChild(b);
});

// ---- body
const body = document.getElementById("mbody");
const groupSpans = {};
METRICS.forEach(m=>{ groupSpans[m.grp]=(groupSpans[m.grp]||0)+1; });
const groupDone = {};

METRICS.forEach(m=>{
  const tr=document.createElement("tr");
  if(m.last) tr.className="grp-end";
  if(!groupDone[m.grp]){
    groupDone[m.grp]=true;
    const g=document.createElement("th");
    g.className="grp"; g.rowSpan=groupSpans[m.grp]; g.scope="rowgroup"; g.textContent=m.grp;
    tr.appendChild(g);
  }
  const th=document.createElement("th");
  th.className="metric"; th.scope="row";
  th.innerHTML = m.name + "<small>" + m.sub + " · predicted " + (m.pred>0?"higher":"lower") + " in IR</small>";
  tr.appendChild(th);

  SITES.forEach(s=>{
    const td=document.createElement("td"); td.className="cellbox";
    const e = D[s.k][m.k] || {};
    const val = ("d" in e) ? e.d : null;
    const sign = val!==null ? Math.sign(val) : e.dir;
    const btn=document.createElement("button");
    btn.className="cell"; btn.type="button"; btn.setAttribute("aria-pressed","false");
    btn.style.background = fill(val!==null ? val : sign*0.12, !!e.keyed);

    const contra = e.keyed && (Math.sign(val) !== m.pred);
    if(e.keyed){ btn.classList.add("keyed"); }
    if(contra){ btn.classList.add("contra"); }

    if(e.keyed){
      btn.innerHTML = fmt(val) + (e.q ? '<span class="qmark">q '+e.q+'</span>' : "");
      if(Math.abs(val) > 0.42) btn.style.color = "#fff";
    } else if(val!==null){
      btn.innerHTML = '<span class="glyph">'+(val>0?"▲":"▼")+" "+fmt(val)+'</span>';
    } else {
      btn.innerHTML = '<span class="glyph">'+(sign>0?"▲":"▼")+'</span>';
    }

    btn.setAttribute("aria-label", m.name+" at "+s.label);
    btn.addEventListener("click", ()=>select(btn, s, m, e, contra));
    td.appendChild(btn); tr.appendChild(td);
  });
  body.appendChild(tr);
});

// ---- per-site strip
const sitesEl = document.getElementById("sites");
SITES.forEach(s=>{
  const d=document.createElement("div"); d.className="site";
  d.innerHTML = "<h3>"+s.label+"</h3><p>"+VERDICT[s.k].head+"</p>";
  sitesEl.appendChild(d);
});

// ---- drawer
const drawer = document.getElementById("drawer");
const IDLE = drawer.innerHTML;
let active = null;

function select(btn, s, m, e, contra){
  if(active===btn){
    btn.setAttribute("aria-pressed","false"); active=null; drawer.innerHTML=IDLE; return;
  }
  if(active) active.setAttribute("aria-pressed","false");
  btn.setAttribute("aria-pressed","true"); active=btn;

  const val = ("d" in e) ? e.d : null;
  const dirWord = (val!==null ? val>0 : e.dir>0) ? "higher in IR" : "lower in IR";
  const predWord = m.pred>0 ? "higher in IR" : "lower in IR";

  let stats = "";
  if(e.keyed){
    stats += "<span>Cliff’s δ <b>"+fmt(val)+"</b></span>";
    if(e.ci) stats += "<span>95% CI <b>"+e.ci+"</b></span>";
    if(e.q)  stats += "<span>q <b>"+e.q+"</b></span>";
    if(e.med) stats += "<span>medians <b>"+e.med+"</b></span>";
  } else if(val!==null){
    stats += "<span>Cliff’s δ <b>"+fmt(val)+"</b></span><span>below the 0.33 reporting threshold</span>";
  } else {
    stats += "<span>Below the 0.33 reporting threshold — direction only</span>";
  }
  stats += "<span>n <b>"+s.n+"</b></span>";

  let verdict;
  if(e.keyed && contra){
    verdict = "Observed "+dirWord+"; dysbiosis models predict "+predWord+". <b>The prediction fails here.</b>";
  } else if(e.keyed){
    verdict = "Observed "+dirWord+", the direction dysbiosis models predict.";
  } else {
    verdict = "Directionally "+dirWord+", too small to report as an effect. "+VERDICT[s.k].head+" is what separates the groups at this site.";
  }

  drawer.innerHTML =
    '<p class="dh">'+m.name+' at '+s.label+' <em>— '+m.sub+'</em></p>'+
    '<div class="dstat">'+stats+'</div>'+
    '<p class="dverdict">'+verdict+'</p>'+
    '<p class="dverdict" style="color:var(--muted);font-size:14px">'+VERDICT[s.k].text+'</p>';
}
</script>
</body>
</html>
